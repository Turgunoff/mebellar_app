<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Tracking is TRUE and one tracking domain is declared.

		Build 1.0.39 (39) was rejected with ITMS-91064 because this file shipped
		NSPrivacyTracking=true together with an EMPTY NSPrivacyTrackingDomains
		array. Apple TN3181 names that exact combination as invalid:

		  "The value of the NSPrivacyTracking key is true and the value of the
		   NSPrivacyTrackingDomains key is an empty array of strings."
		  Solution: "Fill the array with one or more tracking domains your app or
		   third-party SDK connects to."
		  https://developer.apple.com/documentation/technotes/tn3181-debugging-invalid-privacy-manifest

		Why true (and not the other permitted fix, false + no domains): the
		DeviceID entry below is declared with Tracking=true, because the Meta SDK
		reads the IDFA for ad attribution once ATT is authorised. Declaring the
		app as non-tracking while declaring a data type as tracking would be
		self-contradictory.

		Why only ep1.facebook.com: that is the App Events endpoint FBSDKCoreKit
		declares in its own FBSDKCoreKit.framework/PrivacyInfo.xcprivacy. It is
		events-only. Do NOT add graph.facebook.com, m.facebook.com or bare
		facebook.com here - iOS blocks listed domains when ATT is denied, and
		blocking those would break Facebook login and sharing. Meta warns about
		exactly that: "Listing 'www.facebook.com' or subdomains of 'facebook.com'
		in the tracking domain field of a Privacy Manifest may break
		functionality." - https://developers.facebook.com/docs/ios

		Blocking ep1.facebook.com under a denied ATT prompt costs us nothing:
		MetaConsentGate already refuses to emit events in that state.

		App Store Connect > App Privacy must answer YES to "Used to Track You"
		for Device ID, to match this file.
	-->
	<key>NSPrivacyTracking</key>
	<true/>

	<key>NSPrivacyTrackingDomains</key>
	<array>
		<string>ep1.facebook.com</string>
	</array>


	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
			Device advertising identifier (IDFA). Read by the Meta SDK for
			ad attribution once ATT is authorised, and by Firebase Analytics
			for its own measurement. This is the one entry that is genuinely
			"tracking" under Apple's definition.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!--
			Woody account id set on Firebase Analytics (AuthCubit →
			AnalyticsService.setUserId). NOT sent to Meta — the Facebook
			wrapper's setUserId has no call site today.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			Purchase / cart events (AddToCart, InitiateCheckout, Purchase) go
			to both Firebase and Meta with amount, currency and product ids.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!--
			Screen views and in-app events (ViewContent, search, AR / AI
			usage). Linked — they ride alongside the signed-in user id.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- Firebase Crashlytics -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Firebase Performance / Crashlytics -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			NOT DECLARED — Meta Advanced Matching is written but disabled.
			`FacebookAnalyticsService.setUserProfile` is behind
			`kMetaAdvancedMatchingEnabled` (default false, see AppConfig). The
			DAY that flag ships enabled, add these three entries — the fields
			actually passed to FBSDK's setUserData — and update the App Store
			Connect questionnaire + the privacy policy in the same release:

			  NSPrivacyCollectedDataTypePhoneNumber
			  NSPrivacyCollectedDataTypeName
			  NSPrivacyCollectedDataTypeEmailAddress

			each with Linked=true, Tracking=true and purposes
			ThirdPartyAdvertising + Analytics. Over-declaring them now would
			be just as wrong as under-declaring them later.
		-->
	</array>

	<!--
		Required-reason API declarations. Covers the common categories a Flutter
		app touches (UserDefaults via shared_preferences, file timestamps & disk
		space via path_provider / cache managers, system boot time). Reason codes
		are from Apple's "Describing use of required reason API" list.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
