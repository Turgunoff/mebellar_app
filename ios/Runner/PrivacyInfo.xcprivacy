<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		App-level Apple Privacy Manifest (required since 2024-05-01).
		Third-party SDKs (Firebase, FBSDKCoreKit, shared_preferences, …) ship
		their own manifests inside their frameworks; Apple merges all of them
		into the App Store privacy report. This file covers the app target
		itself. Keep it in sync with the App Store Connect privacy
		questionnaire — the two must agree.

		Tracking is TRUE: the app bundles the Meta (Facebook) App Events SDK,
		prompts for App Tracking Transparency (see MetaConsentGate) and, when
		the user authorises, lets the SDK read the IDFA for ad attribution.
		Collection is consent-gated at runtime (ATT ∧ the in-app
		"Foydalanish statistikasi" toggle), but a manifest declares what the
		app MAY collect, not what a given user happened to allow.
	-->
	<key>NSPrivacyTracking</key>
	<true/>

	<!--
		Deliberately EMPTY.

		The Facebook SDK declares its own tracking domain (ep1.facebook.com)
		inside FBSDKCoreKit.framework/PrivacyInfo.xcprivacy, and Meta's iOS
		docs explicitly tell integrators not to restate them here:

		  "We have pre-populated the tracking domain field for the FBSDK in
		   the Privacy Manifest to help ensure that our services continue to
		   function properly. We do not advise manually adding domains."
		  "Listing 'www.facebook.com' or subdomains of 'facebook.com' in the
		   tracking domain field of a Privacy Manifest may break
		   functionality."
		  — https://developers.facebook.com/docs/ios (App Privacy)

		The app's own code contacts no tracking domain of its own
		(api.woody.uz is first-party), so there is nothing to declare at this
		level. Verified against FBSDKCoreKit 18.1.0 as vendored in
		ios/Pods/FBSDKCoreKit/XCFrameworks/FBSDKCoreKit.xcframework/.
	-->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
			Device advertising identifier (IDFA). Read by the Meta SDK for
			ad attribution once ATT is authorised, and by Firebase Analytics
			for its own measurement. This is the one entry that is genuinely
			"tracking" under Apple's definition.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!--
			Woody account id set on Firebase Analytics (AuthCubit →
			AnalyticsService.setUserId). NOT sent to Meta — the Facebook
			wrapper's setUserId has no call site today.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			Purchase / cart events (AddToCart, InitiateCheckout, Purchase) go
			to both Firebase and Meta with amount, currency and product ids.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!--
			Screen views and in-app events (ViewContent, search, AR / AI
			usage). Linked — they ride alongside the signed-in user id.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- Firebase Crashlytics -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Firebase Performance / Crashlytics -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			NOT DECLARED — Meta Advanced Matching is written but disabled.
			`FacebookAnalyticsService.setUserProfile` is behind
			`kMetaAdvancedMatchingEnabled` (default false, see AppConfig). The
			DAY that flag ships enabled, add these three entries — the fields
			actually passed to FBSDK's setUserData — and update the App Store
			Connect questionnaire + the privacy policy in the same release:

			  NSPrivacyCollectedDataTypePhoneNumber
			  NSPrivacyCollectedDataTypeName
			  NSPrivacyCollectedDataTypeEmailAddress

			each with Linked=true, Tracking=true and purposes
			ThirdPartyAdvertising + Analytics. Over-declaring them now would
			be just as wrong as under-declaring them later.
		-->
	</array>

	<!--
		Required-reason API declarations. Covers the common categories a Flutter
		app touches (UserDefaults via shared_preferences, file timestamps & disk
		space via path_provider / cache managers, system boot time). Reason codes
		are from Apple's "Describing use of required reason API" list.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
