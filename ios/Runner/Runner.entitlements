<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Universal Links. iOS fetches https://woody.uz/.well-known/apple-app-site-association
		and, if the appID matches, opens https://woody.uz/product/* and /shop/*
		directly in the app instead of Safari. The path matching lives in the AASA
		file, not here. Add this capability in Xcode (Signing & Capabilities → +
		Capability → Associated Domains) so CODE_SIGN_ENTITLEMENTS points at this file.
	-->
	<!--
		DEBUG / PROFILE entitlements. The Release configuration points at
		Runner/RunnerRelease.entitlements instead (see CODE_SIGN_ENTITLEMENTS
		in project.pbxproj) — keep the two files in sync except for
		`aps-environment`.

		Push Notifications (FCM → APNs). Required for firebase_messaging to
		register for remote notifications; needs the Push Notifications
		capability enabled on the App ID. "development" targets Apple's
		sandbox gateway, which is what locally-launched debug/profile runs
		need. Do NOT ship an archive with this value — App Store and
		TestFlight builds must be "production" or every push silently drops.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:woody.uz</string>
		<string>applinks:www.woody.uz</string>
	</array>
</dict>
</plist>
