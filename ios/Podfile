# ar_flutter_plugin_plus (native ARKit) requires an iOS 15.0 floor — it links
# ARCore/CloudAnchors + GLTFSceneKit, which won't resolve below 15. That is the
# binding minimum (above Firebase 11.x's iOS 13 floor); pin the project's global
# platform to match so CocoaPods resolves a consistent deployment target.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler compiles every iOS permission handler behind a
    # PERMISSION_* macro that defaults to 0 (see PermissionHandlerEnums.h). When
    # a permission is left at 0 its handler is stripped at compile time, so
    # Permission.<x>.request() returns `denied` WITHOUT ever presenting the
    # native iOS dialog — which is exactly why the camera flow jumped straight to
    # the "open Settings" fallback. Enable only the permissions the app actually
    # uses (camera → AR / 2D try-in-room; microphone → support voice messages);
    # both already carry a matching NS*UsageDescription in Info.plist.
    target.build_configurations.each do |config|
      # Match the AR plugin's iOS 15 floor on every pod — some Flutter plugin
      # pods default to a lower target and would otherwise warn/fail to link.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
      ]
    end
  end
end
