# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# Release artifacts copied out of build/ by tools/shorebird.sh (aab + ipa).
/dist/

# Hive boxes created at runtime by the test suite (zero-byte, timestamped).
/test/.hive/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Admin SDK service-account JSONs — contain a private key that
# can mint OAuth2 tokens against the Firebase project. Never commit.
woody-*-firebase-adminsdk-*.json
*-firebase-adminsdk-*.json
serviceAccountKey.json

# Android signing — the upload keystore and its passwords. A leaked keystore
# lets an attacker sign builds as this app, and key.properties carries the
# store/key passwords. Never commit; provision these out-of-band on the
# release machine / CI secrets.
/android/key.properties
**/*.jks
**/*.keystore
# Stray Firebase config backup. The live android/app/google-services.json
# stays tracked so a fresh clone's Gradle build still resolves it.
/android/app/google-services.json.bak

# Environment / secrets — every env file is ignored except the committed
# template. dev.json / prod.json are un-tracked via `git rm --cached`;
# real keys live only in untracked env files (see env/example.json).
/env/dev.json
/env/prod.json
/env/*.json
!env/example.json

# Shorebird per-project API key (SHOREBIRD_TOKEN). Never commit — each
# machine / CI secret holds its own; tools/shorebird.sh loads this file.
.shorebird_token

# Claude Code — per-user settings stay local; shared settings.json
# (with hook wiring) is committed for the team. Skill installs are
# managed by the user's CLI, not the repo.
.claude/settings.local.json
.claude/skills/

# Marketing screenshot artifacts (integration_test/screenshot_generator_test.dart)
screenshots/

# flutter_test golden-failure output — regenerated on every failing golden run
**/failures/
