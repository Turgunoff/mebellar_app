<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location (Yandex MapKit address picker) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera (image_picker uses Android Photo Picker for gallery — no storage permission required) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Microphone (support-chat hold-to-record voice notes via `record`) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Save AR screenshots to the gallery (gal). gal writes via the legacy
         MediaStore DATA path on API ≤ 29 and scoped RELATIVE_PATH on API 30+,
         so it needs WRITE_EXTERNAL_STORAGE up to API 29 plus the legacy-storage
         opt-in on the <application> below (else API-29 saves fail). API 30+
         drops the permission automatically. ACCESS_MEDIA_LOCATION is NOT
         declared — it only matters for READING original Exif GPS, and this is a
         write-only flow (a Play Console restricted-permission risk otherwise). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion" />

    <!-- Push notifications. POST_NOTIFICATIONS is the runtime prompt on
         Android 13+; FCM declares the rest of its receiver/service in its
         own manifest. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Advertising ID (GAID) is NOT declared here on purpose — it arrives
        through manifest merge and re-declaring it would just create a second
        source of truth to keep in sync.

        Verified in build/app/outputs/logs/manifest-merger-debug-report.txt:
          uses-permission#com.google.android.gms.permission.AD_ID
            ADDED  from com.google.android.gms:play-services-measurement-api
            MERGED from com.facebook.android:facebook-core
        …and it lands in the final merged manifest at
        build/app/intermediates/merged_manifest/debug/
        processDebugMainManifest/AndroidManifest.xml (alongside
        android.permission.ACCESS_ADSERVICES_AD_ID).

        Android 13+ requires the permission to read the GAID at all; without
        it the Meta SDK gets a zeroed id and attribution quietly degrades
        rather than failing loudly. If Firebase Analytics AND the Facebook
        SDK are ever both removed, the permission disappears with them —
        which is correct, but it also means Play Console's Advertising ID
        declaration must be revisited (see doc/release_checklist.md).
    -->

    <!--
        Declare hardware features as NOT required so the app is visible on
        devices that lack GPS or a rear camera (tablets, ChromeOS, etc.).
    -->
    <uses-feature android:name="android.hardware.location.gps"  android:required="false" />
    <uses-feature android:name="android.hardware.location"      android:required="false" />
    <uses-feature android:name="android.hardware.camera"        android:required="false" />
    <uses-feature android:name="android.hardware.camera.front"  android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
        Auto Backup is fully disabled (allowBackup + fullBackupContent=false)
        and the data-extraction rules exclude everything from cloud backup AND
        device-to-device transfer. Rationale: Hive boxes live under
        getApplicationDocumentsDirectory() (…/app_flutter), NOT …/files/hive,
        so the old path-scoped excludes never matched — a Play Store
        reinstall restored the `settings` box and replayed `tutorial_seen_v1`,
        skipping onboarding. Restoring stale auth tokens / flags onto a fresh
        install is also a security/UX hazard for an e-commerce app, so we opt
        out of backup entirely rather than chase per-path excludes.
    -->
    <!--
        requestLegacyExternalStorage: API 29 only. gal saves AR screenshots via
        the legacy MediaStore DATA path on API ≤ 29, which needs legacy storage
        on Android 10; ignored on API 30+ (scoped storage). No other component
        writes to shared external storage.
    -->
    <application
        android:name=".MainApplication"
        android:label="Woody"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: open https://woody.uz/product/* and /shop/*
                 directly in the app when installed. autoVerify makes Android
                 fetch https://woody.uz/.well-known/assetlinks.json and, if the
                 signing-cert fingerprint matches, skip the disambiguation
                 chooser. The flutter_deeplinking_enabled meta-data below hands
                 the inbound path to go_router. Within one intent-filter Android
                 cross-products every host × pathPrefix, so all four combos
                 (woody.uz|www.woody.uz × /product|/shop) match. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="woody.uz" android:pathPrefix="/product" />
                <data android:scheme="https" android:host="www.woody.uz" android:pathPrefix="/product" />
                <data android:scheme="https" android:host="woody.uz" android:pathPrefix="/shop" />
                <data android:scheme="https" android:host="www.woody.uz" android:pathPrefix="/shop" />
            </intent-filter>
        </activity>

        <!-- Flutter plugin registry -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Hand verified App Links (and any custom-scheme deep links) to the
             Flutter engine so go_router's route-information parser receives
             the path (e.g. /product/123). Without this Android opens the app
             but Flutter ignores the inbound URL. -->
        <meta-data
            android:name="flutter_deeplinking_enabled"
            android:value="true" />

        <!-- Default notification channel for FCM. Without this, foreground
             pushes on Android 8+ fall back to the catch-all channel and the
             user can't toggle "news" off independently. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="news" />

        <!-- FCM small icon shown in the status bar. MUST be a white-on-
             transparent silhouette — a colour launcher icon renders as a white
             square because Android draws only the icon's alpha. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_woody" />
        <!-- Accent applied to the expanded notification (and the small icon on
             some OEMs). Brand terracotta. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- Facebook SDK (facebook_app_events). The production App ID + Client
             Token live in res/values/strings.xml. The INTERNET permission the
             SDK needs is already declared at the top of this manifest.

             Auto-logging + advertiser-ID collection are held OFF here so the
             SDK never tracks before consent is resolved; FacebookAnalyticsService
             .initialize() flips them on at runtime (Android has no ATT gate, so
             it enables immediately). This mirrors the consent-delay pattern the
             FB SDK documents for GDPR. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />
    </application>

    <queries>
        <!-- Flutter ProcessTextPlugin -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- url_launcher: open https links in browser -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- url_launcher: dial phone numbers -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- url_launcher: open Telegram deep links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
        <!-- url_launcher: Payme / Click checkout deep links. The backend returns
             https:// checkout URLs (covered by the https entry above); these
             custom schemes let the app also query/open the native payment apps. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="payme" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="click" />
        </intent>
    </queries>

</manifest>
