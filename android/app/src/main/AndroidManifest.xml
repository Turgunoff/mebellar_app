<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location (Yandex MapKit address picker) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera (image_picker uses Android Photo Picker for gallery — no storage permission required) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Push notifications. POST_NOTIFICATIONS is the runtime prompt on
         Android 13+; FCM declares the rest of its receiver/service in its
         own manifest. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Declare hardware features as NOT required so the app is visible on
        devices that lack GPS or a rear camera (tablets, ChromeOS, etc.).
    -->
    <uses-feature android:name="android.hardware.location.gps"  android:required="false" />
    <uses-feature android:name="android.hardware.location"      android:required="false" />
    <uses-feature android:name="android.hardware.camera"        android:required="false" />
    <uses-feature android:name="android.hardware.camera.front"  android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
        Auto Backup is fully disabled (allowBackup + fullBackupContent=false)
        and the data-extraction rules exclude everything from cloud backup AND
        device-to-device transfer. Rationale: Hive boxes live under
        getApplicationDocumentsDirectory() (…/app_flutter), NOT …/files/hive,
        so the old path-scoped excludes never matched — a Play Store
        reinstall restored the `settings` box and replayed `tutorial_seen_v1`,
        skipping onboarding. Restoring stale auth tokens / flags onto a fresh
        install is also a security/UX hazard for an e-commerce app, so we opt
        out of backup entirely rather than chase per-path excludes.
    -->
    <application
        android:name=".MainApplication"
        android:label="Woody"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: open https://woody.uz/product/* and /shop/*
                 directly in the app when installed. autoVerify makes Android
                 fetch https://woody.uz/.well-known/assetlinks.json and, if the
                 signing-cert fingerprint matches, skip the disambiguation
                 chooser. The flutter_deeplinking_enabled meta-data below hands
                 the inbound path to go_router. Within one intent-filter Android
                 cross-products every host × pathPrefix, so all four combos
                 (woody.uz|www.woody.uz × /product|/shop) match. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="woody.uz" android:pathPrefix="/product" />
                <data android:scheme="https" android:host="www.woody.uz" android:pathPrefix="/product" />
                <data android:scheme="https" android:host="woody.uz" android:pathPrefix="/shop" />
                <data android:scheme="https" android:host="www.woody.uz" android:pathPrefix="/shop" />
            </intent-filter>
        </activity>

        <!-- Flutter plugin registry -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Hand verified App Links (and any custom-scheme deep links) to the
             Flutter engine so go_router's route-information parser receives
             the path (e.g. /product/123). Without this Android opens the app
             but Flutter ignores the inbound URL. -->
        <meta-data
            android:name="flutter_deeplinking_enabled"
            android:value="true" />

        <!-- Default notification channel for FCM. Without this, foreground
             pushes on Android 8+ fall back to the catch-all channel and the
             user can't toggle "news" off independently. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="news" />
    </application>

    <queries>
        <!-- Flutter ProcessTextPlugin -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- url_launcher: open https links in browser -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- url_launcher: dial phone numbers -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- url_launcher: open Telegram deep links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
    </queries>

</manifest>
