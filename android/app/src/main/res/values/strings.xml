<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Facebook SDK (facebook_app_events) — DISABLED until launch. The App ID /
        Client Token are still placeholders, so FB is inert (events go nowhere;
        FacebookAnalyticsService is non-throwing). These two strings MUST stay —
        AndroidManifest.xml references @string/facebook_app_id and
        @string/facebook_client_token. To enable FB, set both to the real
        Facebook dashboard values (Settings → Basic). fb_login_protocol_scheme is
        omitted (FB Login is unused — it held the invalid fbYOUR_FB_APP_ID
        scheme); add it back as fb<RealAppID> only if you adopt Facebook Login.
    -->
    <string name="facebook_app_id">YOUR_FB_APP_ID</string>
    <string name="facebook_client_token">YOUR_FB_CLIENT_TOKEN</string>
</resources>
